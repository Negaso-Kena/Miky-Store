generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminAccountType {
  OWNER
  STAFF
}

enum ProductPublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InventoryMovementType {
  OPENING_STOCK
  RESTOCK
  SALE
  ADJUSTMENT
  RETURN
  CANCELLATION_RESTOCK
}

enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

model AdminUser {
  id           String           @id @default(uuid()) @db.Uuid
  fullName     String           @db.VarChar(120)
  username     String           @unique @db.VarChar(60)
  email        String?          @unique @db.VarChar(255)
  passwordHash String           @db.VarChar(255)
  accountType  AdminAccountType @default(STAFF)
  isActive     Boolean          @default(true)
  sessions           AdminSession[]
  inventoryMovements InventoryMovement[]
  orderStatusChanges OrderStatusHistory[]
  auditLogs          AuditLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model AdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @db.Uuid
  tokenHash   String    @unique @db.VarChar(255)
  expiresAt   DateTime
  revokedAt   DateTime?
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
  @@index([expiresAt])
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

model Product {
  id                 String                   @id @default(uuid()) @db.Uuid
  categoryId         String                   @db.Uuid
  name               String                   @db.VarChar(180)
  slug               String                   @unique @db.VarChar(200)
  sku                String                   @unique @db.VarChar(80)
  description        String?
  price              Decimal                  @db.Decimal(12, 2)
  unitCode           String                   @default("piece") @db.VarChar(30)
  publicationStatus  ProductPublicationStatus @default(DRAFT)
  isAvailableForSale Boolean                  @default(true)
  category           Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images             ProductImage[]
  specifications     ProductSpecification[]
  inventory          Inventory?
  movements          InventoryMovement[]
  orderItems         OrderItem[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([categoryId, publicationStatus])
  @@index([publicationStatus, createdAt])
}

model ProductImage {
  id                 String   @id @default(uuid()) @db.Uuid
  productId          String   @db.Uuid
  imageUrl           String   @db.VarChar(2048)
  cloudinaryPublicId String   @db.VarChar(255)
  altText            String   @db.VarChar(255)
  sortOrder          Int      @default(0)
  isPrimary          Boolean  @default(false)
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())

  @@index([productId, sortOrder])
}

model ProductSpecification {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  name      String  @db.VarChar(100)
  value     String  @db.VarChar(500)
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Inventory {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @unique @db.Uuid
  quantityOnHand    Decimal  @default(0) @db.Decimal(12, 3)
  lowStockThreshold Decimal? @db.Decimal(12, 3)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  updatedAt         DateTime @updatedAt
}

model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  productId      String                @db.Uuid
  adminUserId    String?               @db.Uuid
  orderId        String?               @db.Uuid
  movementType   InventoryMovementType
  quantityChange Decimal               @db.Decimal(12, 3)
  quantityBefore Decimal               @db.Decimal(12, 3)
  quantityAfter  Decimal               @db.Decimal(12, 3)
  reason         String?               @db.VarChar(500)
  idempotencyKey String                @unique @db.VarChar(255)
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  adminUser      AdminUser?            @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  order          Order?                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt      DateTime              @default(now())

  @@index([productId, createdAt])
  @@index([orderId])
}

model Order {
  id                  String            @id @default(uuid()) @db.Uuid
  orderNumber         String            @unique @db.VarChar(40)
  customerName        String            @db.VarChar(120)
  customerPhone       String            @db.VarChar(30)
  fulfillmentMethod   FulfillmentMethod
  deliveryAddress     String?
  subtotal            Decimal           @db.Decimal(12, 2)
  deliveryFee         Decimal?          @db.Decimal(12, 2)
  total               Decimal?          @db.Decimal(12, 2)
  customerNote        String?
  status              OrderStatus       @default(PENDING)
  submissionKey       String            @unique @db.VarChar(100)
  inventoryDeductedAt DateTime?
  inventoryRestoredAt DateTime?
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  inventoryMovements  InventoryMovement[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([customerPhone])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  productId   String?  @db.Uuid
  productName String   @db.VarChar(180)
  sku         String   @db.VarChar(80)
  unitCode    String   @db.VarChar(30)
  unitPrice   Decimal  @db.Decimal(12, 2)
  quantity    Decimal  @db.Decimal(12, 3)
  lineTotal   Decimal  @db.Decimal(14, 2)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([orderId, productId])
  @@index([productId])
}

model OrderStatusHistory {
  id               String       @id @default(uuid()) @db.Uuid
  orderId          String       @db.Uuid
  changedByAdminId String?      @db.Uuid
  previousStatus   OrderStatus?
  newStatus        OrderStatus
  reason           String?      @db.VarChar(500)
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  changedByAdmin   AdminUser?   @relation(fields: [changedByAdminId], references: [id], onDelete: Restrict)
  createdAt        DateTime     @default(now())

  @@index([orderId, createdAt])
}

model StoreSettings {
  id               String   @id @default("default") @db.VarChar(40)
  storeName        String   @db.VarChar(150)
  currencyCode     String   @default("ETB") @db.VarChar(3)
  logoUrl          String?  @db.VarChar(2048)
  shopAddress      String?
  phone            String?  @db.VarChar(30)
  whatsapp         String?  @db.VarChar(30)
  telegram         String?  @db.VarChar(100)
  deliveryCoverage String?
  updatedAt        DateTime @updatedAt
}

model AuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  adminUserId String?    @db.Uuid
  action      String     @db.VarChar(100)
  entityType  String     @db.VarChar(100)
  entityId    String?    @db.VarChar(100)
  metadata    Json?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  createdAt   DateTime   @default(now())

  @@index([adminUserId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}
